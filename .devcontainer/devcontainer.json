{
  "name": "Fyra Devdocs",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "USERNAME": "${localEnv:USER}",
      "PNPM_VERSION": "12"
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js Dev Server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "nextjs.vscode-nextjs-extension",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
